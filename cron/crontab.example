# ==============================================================================
# Exemplo de Agendamento Cron para Automação de Backup EBS
# ==============================================================================
# Copie este arquivo ou adicione as linhas ao crontab do usuário (crontab -e)
# Recomenda-se executar sob o usuário de serviço 'ec2-user' ou 'ubuntu' com
# permissão de acesso aos logs.

# Definição de Variáveis de Ambiente no Cron
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
AWS_DEFAULT_REGION=us-east-1

# 1. Execução diária às 02:00 AM com retenção padrão (2 snapshots mais recentes)
0 2 * * * /opt/ebs-backup/venv/bin/python /opt/ebs-backup/backup_ebs.py --tag-key Backup --tag-value True --retention 2 >> /var/log/ebs-backup.log 2>&1

# 2. Alternativa: Execução a cada 12 horas com retenção de 4 snapshots
# 0 */12 * * * /opt/ebs-backup/venv/bin/python /opt/ebs-backup/backup_ebs.py --retention 4 --log-file /var/log/ebs-backup.log

# 3. Alternativa: Execução semanal aos domingos às 03:00 com tag customizada
# 0 3 * * 0 /opt/ebs-backup/venv/bin/python /opt/ebs-backup/backup_ebs.py --tag-key Environment --tag-value Production --retention 3
